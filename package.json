{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:node": "tsx --test lib/engine/progression.test.ts lib/motion/core.test.ts",
    "test:unit": "vitest run",
    "content:check": "tsx scripts/content-check.ts",
    "content:new": "tsx scripts/content-new.ts",
    "budget:check": "node scripts/check-budgets.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:node && npm run test:unit && npm run content:check",
    "verify": "npm run check && NODE_ENV=production npm run build && npm run budget:check",
    "clean": "next clean",
    "generate:assets": "node scripts/generate-tokens.mjs && node scripts/generate-rough-paths.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.1",
    "canvas-confetti": "^1.9.4",
    "culori": "^4.0.2",
    "eslint-plugin-boundaries": "^7.4.5",
    "fast-check": "^4.11.0",
    "gsap": "^3.15.1",
    "idb": "^8.0.4",
    "jsdom": "^31.0.1",
    "motion": "^14.14.0",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "roughjs": "^4.6.6",
    "simplex-noise": "^4.0.3",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3"
  }
}
